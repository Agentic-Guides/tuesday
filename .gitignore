node_modules/
.env
.env.*
*.log
.DS_Store
Thumbs.db
.wrangler/
dist/
build/
*.zip
*.bak
*.before*.bak

# The video build directory holds large intermediates -- Kokoro wavs, per-beat
# clips, the take -- that a judge does not need. The three scripts that MAKE the
# video do belong in the repo: the README says how the video was produced, and a
# claim about a build should ship with the build.
#
# Note the shape: `devpost-video/*` with a re-include for *.py, NOT
# `devpost-video/`. Git never descends into an excluded directory, so a
# `!devpost-video/*.py` line after `devpost-video/` cannot re-include anything
# (measured: git check-ignore still matched the scripts).
devpost-video/*
!devpost-video/*.py

# Editor/rollback backups — never commit these
*.before-jpg
*.before-imgsize
*.before-*

# OAuth credentials -- never commit these
*client_secret*
*token*
*credentials*
client_secret.json
youtube_token.json

# Raw recording material. The demo video belongs on YouTube and Devpost, not in the
# repository: the takes under _take/ added ~500MB to .git (take1.mp4 alone is 99MB),
# which makes a clone slow for anyone the judges send to this repo. The finished
# video is linked from the README and from the submission form.
#
# Same shape as devpost-video above: `*` with a re-include, because git never
# descends into an excluded directory.
_take/*
!_take/.gitkeep
out/
_tts/
_shot/

# Backups and one-off measurement scripts are not part of the product. The audit
# scripts that produced the numbers in the README are kept, but as named tools in
# docs/scripts, not as underscore-prefixed scratch files in the root.
*.bak_*
*.bak_round*
*.bak_before_*
_audit_*.mjs
_check_*.mjs
_measure_*.mjs
_plan_*.mjs
_seed_*.mjs
_verify_*.mjs
_*.py
!docs/scripts/*.py
devpost-video/_*.py
demo/index.html.bak*

# Old demo cuts. Only the current cut belongs in the tree; earlier takes are
# superseded and add hundreds of MB to a clone.
devpost-media/tuesday_submission_v17_*.mp4
devpost-media/tuesday_submission_v18_1080p_cursor.mp4
devpost-media/tuesday_submission_v18_final.mp4

# No rendered video in the tree. The demo video lives on YouTube (linked from the
# README and the Devpost form) and is 18-20MB per cut; two cuts in git would make
# every clone 38MB heavier for a file nobody needs to build the project.
devpost-media/*.mp4
