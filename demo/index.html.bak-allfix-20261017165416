<!-- ★ Bryntum Scheduler (trial) — audit timeline. Pinned version; CDN so deps stay zero.
     The light "stockholm" theme, not "stockholm-dark": the demo is a light UI, and a black
     timeline grid in a white page reads as a rendering bug rather than a design choice. -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@bryntum/scheduler-trial@7.3.6/scheduler.css" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@bryntum/scheduler-trial@7.3.6/stockholm.css" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/@bryntum/scheduler-trial@7.3.6/scheduler.umd.js"></script crossorigin="anonymous">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0 }
  :root {
    /* ★ベージュ階層（hai Lab の paper/ink 設計を赤に翻訳） */
    --bg: #f0eadf;           /* 一番外側＝温かい紙（ベージュ） */
    --panel-2: #e8e1d3;      /* 沈んだ面（濃いベージュ） */
    --sunken: #e2dac9;       /* さらに沈む面 */
    --panel: #ffffff;        /* カード＝純白で浮かせる */
    --line: #d9d0bd;         /* 罫線（ベージュ寄り） */
    --line-2: #c9bfa9;       /* 強めの罫線 */
    --adv: #15803d; --aud: #be123c; --wit: #1d4ed8;
    --gold: #c0203c; --dim: #5c554b; --txt: #241f1a;
  }
  body { background: var(--bg); color: var(--txt); font: 16px/1.6 -apple-system, "Segoe UI", sans-serif; min-height: 100vh; padding: 24px }
  .wrap { max-width: 1120px; margin: 0 auto }
  header { text-align: center; margin-bottom: 24px }
  h1 { font-size: 34px; letter-spacing: 3px; font-weight: 800;
       background: linear-gradient(90deg, var(--adv), var(--wit), var(--aud));
       -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .sub { color: #3d372f; font-size: 15px; margin-top: 4px }
  .tags { margin: 16px 0 24px; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .tag { font-size: 10px; letter-spacing: .14em; font-weight: 700; color: #241f1a; border: 1px solid var(--line); background: var(--sunken); padding: 4px 12px; border-radius: 999px; display: inline-flex; align-items: center; }
  .panel {
    position: relative;
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.123);
    border-radius: 26px;
    padding: 24px 24px 24px; margin-bottom: 24px;
    box-shadow:
      0 1px 0 rgba(0,0,0,0.051); inset,
      0 26px 60px -34px rgba(88,60,180,.45),
      0 2px 10px -4px rgba(0,0,0,.45);
  }
  /* 上端の光るライン（光が当たっているように見せる） */
  .panel::after {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--line) 30%, var(--line) 70%, transparent);
    border-radius: 26px 26px 0 0; pointer-events: none;
  }
  /* 内側のヘアライン（Double-Bezel の「内殻」に相当） */
  .panel::before {
    content: ""; position: absolute; inset: 6px;
    border: 1px solid rgba(0,0,0,0.038);
    border-radius: 20px; pointer-events: none;
  }
  .panel > * { position: relative; z-index: 1; }
  .panel h2 { font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--dim); margin-bottom: 12px }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px }
  .grid2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px }
  .agent { background: #ffffff; border-radius: 10px; padding: 16px; border: 1px solid var(--line); }
  .agent.advocate { border-top: 3px solid var(--adv); }
  .agent.auditor { border-top: 3px solid var(--aud); }
  .agent.witness { border-top: 3px solid var(--wit); }
  .agent h3 { font-size: 15px; margin-bottom: 0px }
  .agent .role { font-size: 11px; color: var(--dim); text-transform: uppercase; letter-spacing: 1px; }
  .verdict { display:inline-block; margin-top: 8px; font-size:11px; font-weight:700; padding: 4px 8px; border-radius:6px; text-transform:uppercase; }
  .v-for { background:#dcfce7; color:var(--adv); }
  .v-against { background:#fee2e2; color:var(--aud); }
  .v-neutral { background:#dbeafe; color:var(--wit); }
  .reasons { margin-top: 12px; font-size: 16px; color: #52525b; }
  .reasons li { margin: 4px 0 4px 16px }
  .conf { margin-top: 8px; font-size:11px; color:var(--dim); }
  input, select { width: 100%; background:#ffffff; border:1px solid var(--line); color:var(--txt);
                  padding: 12px 12px; border-radius:9px; font-size:14px; outline:none; }
  input:focus { border-color:#a1a1aa; }
  label { display:block; font-size:12px; color:var(--dim); margin-bottom: 4px; text-transform:uppercase; letter-spacing:.8px; }
  .field { margin-bottom: 12px }
  button { width:100%; margin-top: 4px; padding: 12px; border:none; border-radius:9px; font-size:15px; font-weight:700;
           background: linear-gradient(90deg,#be123c,#c0203c); color:#fef3c7; cursor:pointer; letter-spacing:.5px; }
  button:hover { filter: brightness(1.08); }
  button:disabled { opacity:.5; cursor:wait; }
  button.secondary { background:var(--sunken); color:var(--txt); }
  .decision { text-align:center; padding: 16px; border-radius:12px; margin-bottom: 16px }
  .d-APPROVED { background:#dcfce7; border:1px solid #166534; }
  .d-CONDITIONAL { background:#92400e; border:1px solid #b45309; color:#ffffff; }
  .d-DENIED { background:#fee2e2; border:1px solid #991b1b; }
  .d-DISSENT { background:#9a3412; border:1px solid #c2410c; color:#ffffff; }
  .decision .big { font-size:26px; font-weight:800; letter-spacing:2px; }
  .vote { color:var(--dim); font-size:12px; margin-top: 4px }
  .map { background:#ffffff; border-left:3px solid var(--gold); padding: 12px; border-radius:8px; margin-top: 12px }
  .map h4 { font-size:12px; color:var(--gold); text-transform:uppercase; letter-spacing:1px; margin-bottom: 8px }
  .map-row { font-size:13px; margin: 4px 0 }
  /* The approval link is the one thing on this panel a human must click, and it
     was rendering as a 66-character URL in --gold (#c0203c) at 13px, which reads
     as a red smear on the white panel. Give it a button surface with the URL in
     a monospace line underneath: the colour is now a dark red-ink on a tinted
     chip (measured 8.2:1) and the target is a 44px tap area. */
  .approval { margin: 10px 0 4px; padding: 12px 14px; border-radius: 12px;
              background: #fdf1ee; border: 1px solid #e7c9c3; }
  .approval .k { font-size:11px; text-transform:uppercase; letter-spacing:1px;
                 color:#7a2318; font-weight:700; margin-bottom:6px }
  .approval a { display:inline-flex; align-items:center; gap:8px; min-height:44px;
                padding:9px 16px; border-radius:999px; background:#c0203c;
                color:#ffffff !important; font-weight:700; font-size:13.5px;
                text-decoration:none !important }
  .approval a:hover { background:#9f1a31; color:#ffffff !important }
  .approval .url { display:block; margin-top:8px; font-family:ui-monospace,Menlo,Consolas,monospace;
                   font-size:11px; color:#5c554b; word-break:break-all; line-height:1.5 }
  .pill { font-size:10px; padding: 0px 8px; border-radius:99px; background:var(--sunken); color:var(--dim); }
  .hidden { display:none; }
  a { color: var(--gold); }
  .tabbar { display:flex; gap: 8px; justify-content:center; margin: 0 0 24px }
  .tab { padding: 8px 16px; border-radius:8px; background:var(--sunken); color:#241f1a; cursor:pointer; font-size:13px; font-weight:700; }
  .tab.active { background:#c0203c; color:#ffffff; border-color:#c0203c; }
  #candidateGrid, #ledgerGrid, #auditGrid {
    width: 100%;
    /* height is set by fitGridHeight() from the actual row count */
  }
  /* ★ AG Grid dashboard — governance metrics */
  #auditGrid { width: 100%; height: 460px; }
  .metrics { display:grid; grid-template-columns:repeat(4,1fr); gap: 12px; margin-bottom: 12px }
  .metric { background:#ffffff; border:1px solid var(--line); border-radius:10px; padding: 12px }
  .metric .k { font-size:11px; color:#241f1a; font-weight:700; text-transform:uppercase; letter-spacing:.08em; }
  .metric .v { font-size:26px; font-weight:800; margin-top: 4px }
  .metric .u { font-size:11px; color:var(--dim); }
  .votechip { display:inline-block; font-size:10px; font-weight:700; padding: 0px 8px; border-radius:6px; margin-right: 4px }
  .vc-for { background:#dcfce7; color:var(--adv); }
  .vc-against { background:#fee2e2; color:var(--aud); }
  .vc-neutral { background:#dbeafe; color:var(--wit); }
  .receipt { background:#ffffff; border:1px solid var(--line); border-radius:10px; padding: 16px; margin-top: 12px }
  .receipt h4 { font-size:12px; color:var(--gold); text-transform:uppercase; letter-spacing:1px; margin-bottom: 8px }
  .kv { display:grid; grid-template-columns:150px 1fr; gap: 4px 12px; font-size:14px; }
  .kv .k { color:var(--dim); }
  .kv .v { font-family:ui-monospace,Menlo,Consolas,monospace; word-break:break-all; }
  /* AG Grid: レシート列はツールチップで全文を見せる（セルは壊さない） */
  .ag-theme-quartz .ag-cell[col-id='receipt'] {
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 12px;
  }
  .ok { color:var(--adv); font-weight:700; }
  .bad { color:var(--aud); font-weight:700; }
  .verify-bar { display:flex; gap: 8px; align-items:center; margin-top: 12px }
  .verify-bar button { width:auto; padding: 8px 16px; font-size:13px; margin: 0 }
  .verdict-line { font-size:13px; margin-top: 8px }
  /* ★ Bryntum dispute-triage flag: unresolved case = must not be missed */
  .b-sch-event.triage-flag { outline:2px solid #c0203c; outline-offset:1px; box-shadow:0 0 10px rgba(251,191,36,.55); }
  /* Force dark theme (robust across AG Grid versions) */
  .ag-theme-quartz, .ag-theme-quartz .ag-root-wrapper { background:#ffffff; }
  .ag-theme-quartz .ag-header { background:var(--panel-2) !important; border-bottom:1px solid var(--line); }
  .ag-theme-quartz .ag-header-cell, .ag-theme-quartz .ag-header-group-cell { color:#241f1a !important; font-weight:700; }
  .ag-theme-quartz .ag-row { background:#ffffff !important; color:var(--txt) !important; border-color:#fafafa !important; }
  .ag-theme-quartz .ag-row-odd { background:var(--panel-2) !important; }
  .ag-theme-quartz .ag-row:hover { background:var(--sunken) !important; }
  .ag-theme-quartz .ag-cell { color:var(--txt) !important; }
  .ag-theme-quartz .ag-body, .ag-theme-quartz .ag-center-cols-viewport,
  .ag-theme-quartz .ag-body-viewport { background:#ffffff !important; }
  .ag-theme-quartz .ag-root-wrapper { border:1px solid var(--line) !important; border-radius:10px; }
  .reco { background:#dcfce7; border:1px solid #166534; border-radius:10px; padding: 12px; margin-bottom: 12px }
  .reco.cond { background:#92400e; border-color:#b45309; color:#ffffff; }
  /* Measured on the live demo: the CONDITIONAL card is a brown background, but
     the copy inside it inherited the page's warm text colour, so the title and
     the "candidates · evaluated" line were orange-on-brown and unreadable. Set
     the foreground for the whole card, then the .p/.t overrides below. */
  .reco.cond .t { color:#ffffff; }
  .reco.cond .p { color:#ffd9a0; }
  .reco.cond span[style] { color:#fde8cf !important; }
  .reco.cond div[style] { color:#fde8cf !important; }
  /* Links are --gold (#c0203c) globally, which is 1.19:1 on the brown card and
     the dark conditional/dissent chips — measured unreadable. Inside any dark
     surface, links have to carry a light colour instead. */
  /* Two different surfaces need two different link colours:
     .reco.cond is solid brown (#92400e) -> link must be LIGHT
     .d-CONDITIONAL/.d-DISSENT chips are a 10% tint on white -> link must be DARK.
     Sharing one colour made the approval link 1.32:1 on the brown card. */
  .reco.cond a { color:#ffd9a0 !important; text-decoration:underline; }
  .d-CONDITIONAL a, .d-DISSENT a { color:#7c2d12 !important; text-decoration:underline; }
    .reco.cond a:hover { color:#ffffff !important; }
  .d-CONDITIONAL a:hover, .d-DISSENT a:hover { color:#000000 !important; }
  .reco .t { font-size:15px; font-weight:700; }
.proof-lede { font-size: 13.5px; color: var(--dim); line-height: 1.65; margin: 0 0 16px; max-width: 70ch }
.proof-lede code { font-size: 12.5px; background: var(--sunken); padding: 1px 5px; border-radius: 5px }
.proof-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 22px }
.proof-steps > li { border-left: 3px solid var(--line); padding-left: 16px }
.step-head { display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap; margin-bottom: 10px }
.step-n { display: inline-flex; align-items: center; justify-content: center;
          width: 22px; height: 22px; min-width: 22px; border-radius: 999px;
          background: var(--gold); color: #fff; font-size: 12px; font-weight: 700 }
.step-head b { font-size: 14.5px }
.step-sub { font-size: 12.5px; color: var(--dim); line-height: 1.55; display: block; width: 100%; margin-top: 2px }
.step-sub code { font-size: 11.5px; background: var(--sunken); padding: 1px 5px; border-radius: 5px }
#ledgerVerifyOut { margin-top: 14px }
.vcard { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; font-size: 12.5px }
.vcard table { border-collapse: collapse; width: 100% }
.vcard th, .vcard td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--line) }
.vcard th { background: var(--sunken); color: var(--dim); font-size: 11px;
            text-transform: uppercase; letter-spacing: .04em; font-weight: 700; width: 42% }
.vcard tr:last-child th, .vcard tr:last-child td { border-bottom: none }
.vcard .ok { color: #1c7a4a; font-weight: 600 }
.vcard .bad { color: var(--gold); font-weight: 600 }
.btn-secondary { background: var(--panel); color: var(--txt); border: 1px solid var(--line) }
.btn-secondary:hover:not(:disabled) { background: var(--sunken) }
#gridTable { overflow-x: auto; margin: 18px 0 0 }
#gridTable table { border-collapse: collapse; font-size: 12.5px; width: 100% }
#gridTable th, #gridTable td { border: 1px solid var(--line); padding: 9px 10px; text-align: center }
#gridTable th { background: var(--sunken); font-weight: 700; font-size: 11.5px;
                text-transform: uppercase; letter-spacing: .04em; color: var(--dim) }
#gridTable td.amt { background: var(--sunken); font-weight: 700; font-variant-numeric: tabular-nums }
#gridTable td.v-APPROVED    { background: #dff3e6; color: #14532d; font-weight: 600 }
#gridTable td.v-CONDITIONAL { background: #fdf0d5; color: #7a4a06; font-weight: 600 }
#gridTable td.v-DENIED      { background: #fbe0e3; color: #8b1a26; font-weight: 600 }
#gridTable td.v-unknown     { background: var(--sunken); color: var(--dim) }
.proof-verdict { font-size: 15px; font-weight: 700; letter-spacing: .01em; margin: 4px 0 14px }
.proof-verdict.pass { color: #1c7a4a }
.proof-verdict.fail { color: var(--gold) }
.proof-note { font-size: 12.5px; color: var(--dim); line-height: 1.6; margin: 14px 0 0 }
.proof-note code { font-size: 11.5px; background: var(--sunken); padding: 1px 5px; border-radius: 5px }
#proofLog {
  background: var(--sunken); border: 1px solid var(--line); border-radius: 14px;
  padding: 14px 16px; margin: 0; max-height: 300px; overflow: auto;
  font: 11.5px/1.55 ui-monospace, "Cascadia Mono", Consolas, monospace;
  color: var(--txt); white-space: pre; tab-size: 2;
}
.reco-img { float:left; width:112px; height:112px; object-fit:cover; border-radius:14px; margin:0 16px 8px 0;
            background:#fff; box-shadow:0 1px 4px rgba(60,45,30,.16) }
.reco::after { content:''; display:block; clear:both }
  .reco .p { color:var(--gold); font-size:20px; font-weight:800; }
  /* Category chips: the four stocked categories, so a judge clicks instead of guessing. */
  .cat-chips { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px }
  .cat-chip { min-height:34px; padding:6px 12px; font-size:12px; font-weight:600;
              border-radius:999px; border:1px solid var(--line-2); background:var(--sunken);
              color:#241f1a; cursor:pointer; transition:all .2s cubic-bezier(.32,.72,0,1) }
  .cat-chip:hover { border-color:#c0203c; color:#241f1a }
  .cat-chip.is-on { background:#c0203c; border-color:#c0203c; color:#ffffff }

  
  /* ═══════════════════════════════════════════════════════════════════
     ★ Ethereal Glass レイヤー（2026-10-10 v2）
     high-end-visual-design スキル準拠:
       - フォント: Plus Jakarta Sans（Geist 代替・Inter 禁止）
       - 配色: OLED #18181b + radial mesh gradient（紫/緑の光球）
       - 影: 黒ベタ禁止 → 背景の色味を帯びた影（青紫寄り）
       - 遷移: custom cubic-bezier（linear/ease-in-out 禁止）
       - blur: 固定/ヘッダのみ（スクロール要素には当てない）
       - カード: Double-Bezel（外殻 + 内殻）
       - ボタン: 丸ピル + Button-in-Button
     ═══════════════════════════════════════════════════════════════════ */

  /* ── 基盤：OLED黒 + radial mesh gradient ──────────────────────── */
  html { scroll-behavior: smooth; }
  body {
    font-family: "Plus Jakarta Sans", -apple-system, "Segoe UI", sans-serif;
    background:
      radial-gradient(1100px 700px at 50% -20%, rgba(225,29,72,.035), transparent 64%),
      radial-gradient(860px 540px at 94% 4%, rgba(148,163,184,.05), transparent 66%), #f0eadf;
    background-attachment: fixed;
    padding: 48px 24px 96px;
    letter-spacing: .01em;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 1180px; }

  /* ── 見出し：重く・詰める・存在感 ───────────────────────────── */
  h1 {
    font-size: clamp(40px, 6.6vw, 74px);
    letter-spacing: -.028em;
    line-height: .96;
    font-weight: 800;
    background: linear-gradient(180deg, #18181b 0%, #52525b 62%, #52525b 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 12px 40px rgba(0,0,0,.55));
  }
  .sub { font-size: 15px; line-height: 1.75; color: #3d372f; max-width: 68ch; margin: 16px auto 0; text-wrap: balance; }
  header { margin-bottom: 48px }

  /* ── Eyebrow Tag（見出しの前の微小バッジ）───────────────────── */
  .tags { margin: 16px 0 24px; gap: 8px; justify-content: center }
  .tag { display:inline-flex; align-items:center; font-size:10px; text-transform:uppercase; letter-spacing:.14em; font-weight:700; color:#3f3a33; border:1px solid var(--line-2); background:var(--sunken); padding:4px 12px; border-radius:999px; }
  .tag:hover { border-color: #a1a1aa; background: var(--line); }

  /* ── Double-Bezel（外殻 + 内殻）────────────────────────────── */
  .panel { background: #ffffff; border:1px solid var(--line); border-radius:30px; padding:8px; margin-bottom:24px; box-shadow:0 1px 2px rgba(0,0,0,.04); }
  .panel h2 {
    font-size: 11px; text-transform: uppercase; letter-spacing: .2em;
    color: #241f1a; font-weight: 600; margin-bottom: 16px
  }

  /* ── カード（エージェント）：内殻も二重に ────────────────────── */
  .agent { background:#ffffff; border:1px solid var(--line); border-radius:20px; padding:16px 16px; }
  .agent::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 2px;
    background: linear-gradient(90deg, transparent, currentColor 30%, currentColor 70%, transparent);
    opacity: .6;
  }
  .agent.advocate { color: #15803d; }
  .agent.auditor  { color: #be123c; }
  .agent.witness  { color: #1d4ed8; }
  .agent h3 { font-size: 16px; font-weight: 700; letter-spacing: -.01em; color: #241f1a; }
  .agent .role { font-size: 10px; color: #52525b; letter-spacing: .14em; font-weight: 600; }
  .agent:hover { transform: translateY(-3px); border-color: var(--line-2); }
  .agent.advocate:hover { box-shadow: 0 22px 46px -22px rgba(74,222,128,.42); }
  .agent.auditor:hover  { box-shadow: 0 22px 46px -22px rgba(248,113,113,.42); }
  .agent.witness:hover  { box-shadow: 0 22px 46px -22px rgba(96,165,250,.42); }

  /* ── ボタン：丸ピル + 押下の物理感 ─────────────────────────── */
  button {
    border-radius: 999px; padding: 16px 24px; font-size: 14.5px; font-weight: 700;
    letter-spacing: -.005em;
    background: linear-gradient(180deg, #be123c 0%, #be123c 52%, #c8993f 100%);
    color: #241a06;
    color: #fbfbfe;
    box-shadow: 0 1px 1px rgba(0,0,0,0.323); inset,
                0 10px 28px -14px rgba(200,153,63,.60),
                0 2px 8px -3px rgba(0,0,0,.45);
    transition: transform 0.28s cubic-bezier(.32,.72,0,1),
                box-shadow 0.30s cubic-bezier(.32,.72,0,1),
                filter 0.30s cubic-bezier(.32,.72,0,1);
  }
  button:not(:disabled):hover { transform: translateY(-2px); filter: brightness(1.07);
    box-shadow: 0 1px 1px rgba(0,0,0,0.255); inset, 0 20px 44px -16px rgba(124,92,246,.85); }
  button:not(:disabled):active { transform: translateY(0) scale(.985); }
