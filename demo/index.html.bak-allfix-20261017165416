// --- Pick a candidate and settle it -------------------------------------------------
// The tribunal ranks the whole catalogue; this is where a judge overrides the ranking
// and says "this one". The chosen product is re-adjudicated on its own (so the
// Advocate/Auditor/Witness argue about THIS product, with its real price), and only an
// APPROVED or CONDITIONAL verdict raises a PayPal order. DENIED stays refused -- the
// money gate is the same one the Direct tab uses.
let selectedSku = null;

async function selectCandidate(row) {
  selectedSku = row.id || null;
  const box = document.getElementById('reco');
  const verdict = String(row.decision || '').toUpperCase();
  const canSettle = verdict === 'APPROVED' || verdict === 'CONDITIONAL';

  box.innerHTML = `<div class="reco ${verdict === 'CONDITIONAL' ? 'cond' : ''}">
    ${row.image ? `<img class="reco-img" src="${row.image}" alt="">` : ''}
    <div style="font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:1px">You picked — tribunal says ${verdict}</div>
    <div class="t">${row.title} <span style="color:var(--dim);font-weight:400">· ${row.brand}</span></div>
    <div class="p">$${Number(row.price).toLocaleString()} <span style="font-size:12px;color:var(--dim)">★${row.rating}</span></div>
    <div id="settleOut" style="font-size:12px;color:var(--dim);margin-top:8px">${canSettle
      ? 'Settling through PayPal…'
      : 'Refused by the money gate — no order is created for this product.'}</div>
  </div>`;

  if (!canSettle) {
    document.getElementById('paypalWrap').classList.add('hidden');
    // A judge who clicks a DENIED row sees the PayPal panel disappear and has no
    // way to know that is the point, or how to make one appear. Measured on the
    // live demo: this is exactly the question the panel left unanswered. Name the
    // rule and point at a row that satisfies it.
    const payable = (window.__lastResults || [])
      .filter(x => x.decision === 'APPROVED' || x.decision === 'CONDITIONAL');
    const hint = payable.length
      ? `Approved and conditional verdicts do raise one — click <b>${payable[0].title}</b> ($${Number(payable[0].price).toLocaleString()}, ${payable[0].decision}) in the table to see the PayPal order.`
      : `Nothing in this batch passed the gate, so there is no order to raise. Raise the budget and run the search again to see one.`;
    const out2 = document.getElementById('settleOut');
    if (out2) out2.innerHTML = out2.innerHTML + `<div style="margin-top:8px;padding:8px 10px;border-radius:8px;background:#fdf1ee;border:1px solid #e7c9c3;color:#7a2318">${hint}</div>`;
    return;
  }

  // Re-run the debate on the chosen product so the reasons name its real price.
  const body = {
    category: `${row.brand} ${row.title}`,
    amount: Number(row.price),
    reason: `Judge selected "${row.title}" from the catalogue (rating ${row.rating})`,
    monthlyBudget: Number(document.getElementById('budget').value),
    spentThisMonth: Number(document.getElementById('spent').value),
  };
  const r = await api('/api/adjudicate', body);
  const out = document.getElementById('settleOut');
  if (!r || r.ok === false || !r.decision) {
    out.textContent = (r && r.error) || 'could not adjudicate this product';
    return;
  }
  if (r.decision !== 'APPROVED' && r.decision !== 'CONDITIONAL') {
    out.textContent = `Tribunal re-ruled ${r.decision} on its own — no PayPal order raised.`;
    return;
  }

  const o = await api('/api/order', {
    purchaseId: r.purchase.id,
    returnUrl: 'https://example.com/return',
    cancelUrl: 'https://example.com/cancel',
  });
  // Do NOT capture here. PayPal refuses a capture until the payer approves
  // (UNPROCESSABLE_ENTITY / ORDER_NOT_APPROVED), so an automatic capture would
  // always fail and print a scary error under a verdict that was actually fine.
  // The product's whole claim is that the agents only propose and a human
  // approves, so the order is raised and the approval link is handed over.
  const capHtml = '';
  out.innerHTML = `<div class="map-row">Order <b>${o.orderId || o.error}</b> · mode <b>${o.mode || '-'}</b></div>
    ${o.approvalLink ? `<div class="approval">
      <div class="k">Approval — a human must open this</div>
      <a href="${o.approvalLink}" target="_blank" rel="noopener">Open the PayPal approval page <span aria-hidden="true">↗</span></a>
      <span class="url">${o.approvalLink}</span>
    </div>` : ''}
    ${capHtml}
    <div class="map-row" style="color:var(--dim)">Money moves only after the human approves — agents propose, never settle.</div>`;
  await refreshLedger();
}

