bindRun('run', { idle: '⚖️ Convene the Tribunal', busy: 'Agents deliberating…' }, async () => {
  const body = {
    category: document.getElementById('d_category').value,
    amount: Number(document.getElementById('d_amount').value),
    reason: document.getElementById('d_reason').value,
