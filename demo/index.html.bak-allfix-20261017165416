<script>

/* ★AG Grid: 行数に応じて高さを自動調整（1行も見落とさない） */
function fitGridHeight(gridEl, api, rowCount) {
  if (!gridEl || !api) return;
  const ROW = 36;          // one data row (AG Grid default row height is 25 + padding)
  const HEAD = 48;         // header row
  const PAD = 4;
  // Use the number of rows we just handed to the grid, not what the grid has
  // painted. Calling getDisplayedRowCount() right after setGridOption() returns
  // a stale count (the rows are not laid out yet), so the grid was sized for
  // one or two rows and the last rows were cut off — including the DENIED row,
  // which is the whole point of the table.
  const n = (typeof rowCount === 'number' && rowCount > 0)
    ? rowCount
    : (api.getDisplayedRowCount ? api.getDisplayedRowCount() : 0);
  const want = HEAD + Math.max(1, n) * ROW + PAD;
  // No artificial minimum and no 70%-of-viewport clamp: a five-row table is
  // short, and clamping it to 200px is what hid the last two verdicts.
  gridEl.style.height = want + 'px';
  if (api.doLayout) api.doLayout();
}
let candidateGridApi, ledgerGridApi;

async function api(path, body) {
  // A demo that hangs forever is worse than one that fails: the button stays
  // disabled, every later click is swallowed, and the reviewer sees a frozen
  // page with no error. Abort instead, and let the caller show what happened.
  const ctl = new AbortController();
  const timer = setTimeout(() => ctl.abort(), 15000);
  try {
    const r = await fetch(path, {
      method: body ? 'POST' : 'GET',
      headers: {'Content-Type':'application/json'},
      body: body ? JSON.stringify(body) : undefined,
      signal: ctl.signal,
    });
    if (!r.ok) throw new Error(path + ' returned ' + r.status);
    return await r.json();
  } finally {
    clearTimeout(timer);
  }
}
// Wrap a click handler so the button always comes back, even when something
// throws inside — a disabled button with no error message is indistinguishable
// from a broken demo.
function bindRun(btnId, label, fn) {
  const btn = document.getElementById(btnId);
  btn.onclick = async () => {
    btn.disabled = true;
    btn.textContent = label.busy;
    try {
      await fn();
    } catch (e) {
      console.error(e);
      const d = document.getElementById('decision');
      if (d) {
        d.classList.remove('hidden');
        d.className = 'decision d-DENIED';
        d.querySelector('.big').textContent = 'DENIED';
        d.querySelector('.vote').textContent = 'the tribunal could not be reached: ' + (e && e.message ? e.message : e);
      }
    } finally {
      btn.disabled = false;
      btn.textContent = label.idle;
    }
  };
}
// The gates carry machine ids (G2_within_remaining) because the receipt is data, but a
// person reading a verdict needs the sentence. Translate at the edge, never in the receipt.
const GATE_TEXT = {
  G1_amount_positive:      'the amount has to be a real number',
  G2_within_remaining:     'the money has to be there',
  G3_share_under_half:     'one purchase should not eat over half the month',
  G4_not_repeat_category:  'not a repeat of something just bought',
  G5_survives_double_cost: 'it has to still fit if it ends up costing twice as much',
};
function gateText(id) {
  if (GATE_TEXT[id]) return GATE_TEXT[id];
  return String(id).replace(/^G\d+_/, '').replace(/_/g, ' ');
}

