  // The endpoint rejects an unquantified purchase before the debate runs (a blank
  // or negative amount is not a price). Say that in the product's own words instead
  // of painting "undefined" into the decision slot.
  if (!r || r.ok === false || !r.decision) {
    d.className = 'decision d-DENIED';
    d.querySelector('.big').textContent = 'NOT ADJUDICATED';
    d.querySelector('.vote').textContent =
      (r && r.error) || 'the purchase could not be audited';
    document.getElementById('agents').innerHTML = '';
    document.getElementById('dissentWrap').classList.add('hidden');
    document.getElementById('paypalWrap').classList.add('hidden');
    return;
  }

  d.className = 'decision d-' + r.decision;
  d.querySelector('.big').textContent = r.decision;
  // Say what the settlement state MEANS to a person, not the internal mode flag.
    // "PayPal: MOCK" tells a reader the demo is fake; "settlement: draft — a human must
    // approve" tells them the same true thing in the terms the product's own gate works in.
    const settle = r.paypalMode === 'MOCK' ? 'draft — a human must approve' : `live · ${r.paypalMode}`;
    d.querySelector('.vote').textContent = `${r.votesFor} for · ${r.votesAgainst} against · rule: 2 of 3 · engine: ${r.engine} · settlement: ${settle}`;
  document.getElementById('agents').innerHTML =
    renderAgent(r.arguments.advocate) + renderAgent(r.arguments.auditor) + renderAgent(r.arguments.witness);

  const dw = document.getElementById('dissentWrap');
  if (r.dissentMap) {
    dw.classList.remove('hidden');
    document.getElementById('dissent').innerHTML = r.dissentMap.entries.map(e =>
      `<div class="map"><h4>${e.title} → ${e.verdict}</h4>
        ${e.allReasons.map(x=>`<div class="map-row">• ${x}</div>`).join('')}
        ${e.conditions?`<div class="map-row"><b>Condition:</b> ${e.conditions}</div>`:''}</div>`).join('');
  } else { dw.classList.add('hidden'); }

  const pw = document.getElementById('paypalWrap');
  if (r.decision === 'APPROVED' || r.decision === 'CONDITIONAL') {
    const o = await api('/api/order', { purchaseId: r.purchase.id, returnUrl:'https://example.com/return', cancelUrl:'https://example.com/cancel' });
    let capHtml = '';
    // Same reasoning as the Shop tab: capture waits for the human.
    // See the note above showSettle / the Shop path for the PayPal error this avoids.
    pw.classList.remove('hidden');
    document.getElementById('paypal').innerHTML = `
      <div class="map-row">Order: <b>${o.orderId||o.error}</b> · mode <b>${o.mode||'-'}</b></div>
      ${o.approvalLink?`<div class="approval">
        <div class="k">Approval — a human must open this</div>
        <a href="${o.approvalLink}" target="_blank" rel="noopener">Open the PayPal approval page <span aria-hidden="true">↗</span></a>
        <span class="url">${o.approvalLink}</span>
      </div>`:''}
      ${capHtml}
      <div class="map-row" style="color:var(--dim)">Money moves only after the human approves — agents propose, never settle.</div>`;
  } else { pw.classList.add('hidden'); }

  await refreshLedger();
});

// Init
initCandidateGrid();
initLedgerGrid();
refreshLedger();
</script>
</body>
</html>
