// --- ★ Bryntum: audit timeline ---
let schedulerInst = null;
let __ledger = [];

// Pure transform: ledger entries -> Bryntum resources + events.
// 1 row = one agent. Each bar = that agent's vote on one purchase, at the time it voted.
function ledgerToSchedulerData(entries) {
  const AGENTS = [
    { id: 'advocate', name: 'Advocate' },
    { id: 'auditor',  name: 'Auditor'  },
    { id: 'witness',  name: 'Witness'  },
  ];
  const events = [];
  for (const e of entries) {
    const votes = e.votes || {};
    const at = new Date(e.at);
    const end = new Date(at.getTime() + 1000 * 60 * 20); // 20-min deliberation block
    const stamp = e.receiptHash ? e.receiptHash.slice(0, 8) : '—';
    // ★ Dispute triage: a DENIED/DISSENT case that has not been resolved yet.
    const unresolved = (e.decision === 'DENIED' || e.decision === 'DISSENT');
    for (const a of AGENTS) {
      const verdict = votes[a.id];          // 'for' | 'against' | 'neutral'
      if (!verdict) continue;
      events.push({
        id: `${e.receiptHash || e.at}-${a.id}`,
        resourceId: a.id,
        name: `${a.name} · ${verdict} · $${Number(e.amount || 0).toLocaleString()}`,
        startDate: at,
        endDate: end,
        eventColor: verdict === 'for' ? 'green' : verdict === 'against' ? 'red' : 'blue',
        cls: unresolved ? 'triage-flag' : '',
        evidence: `receipt ${stamp}`,
        decision: e.decision,
      });
    }
  }
  events.sort((x, y) => x.startDate - y.startDate);
  return { resources: AGENTS, events };
}

function initScheduler() {
  const host = document.getElementById('scheduler');
  if (!host) return;
  // CDN unreachable (or already built) → the rest of the demo still works.
  if (typeof bryntum === 'undefined' || !bryntum.scheduler) {
    host.innerHTML = '<div style="padding: 16pxcolor:#52525b">Bryntum Scheduler unavailable (CDN blocked). The rest of the demo is unaffected.</div>';
    return;
  }
  const { resources, events } = ledgerToSchedulerData(__ledger);

  // Metrics for the timeline panel.
  const open = __ledger.filter(e => e.decision === 'DENIED' || e.decision === 'DISSENT').length;
  const evid = __ledger.filter(e => e.receiptHash).length;
  const so = document.getElementById('tlOpen');   if (so) so.textContent = open;
  const se = document.getElementById('tlEvidence'); if (se) se.textContent = evid;

  if (schedulerInst) { schedulerInst.destroy(); schedulerInst = null; }

  const now = Date.now();
  schedulerInst = new bryntum.scheduler.Scheduler({
    appendTo: host,
    startDate: new Date(now - 6 * 3600e3),
    endDate: new Date(now + 6 * 3600e3),
    viewPreset: 'hourAndDay',
    rowHeight: 64,
    barMargin: 6,
    columns: [{ field: 'name', text: 'Agent', width: 150 }],
    resources,
    events,
    eventStyle: 'colored',
    bar: { template: d => `<b>${d.eventRecord.name}</b> <span style="opacity:.8">${d.eventRecord.evidence || ''}</span>` },
    features: { timeRanges: { showCurrentTimeLine: true } },
  });
}

function showTab(which) {
  const map = { shop: 'shopMode', direct: 'directMode', timeline: 'timelineMode' };
  for (const [k, id] of Object.entries(map)) {
    const el = document.getElementById(id);
